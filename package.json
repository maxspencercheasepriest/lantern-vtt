{
  "name": "lantern-vtt",
  "productName": "Lantern VTT",
  "version": "0.14.0",
  "description": "A self-hosted virtual tabletop with video calls, rulesets, combat tracker, notes, built-in rules, a searchable PDF library and GoDice support",
  "author": "Flick",
  "type": "module",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "get-godice": "node scripts/get-godice.js",
    "test": "node --test test/*.test.js && node test/traveller-rules.test.cjs",
    "build-srd": "node scripts/build-srd.js",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage",
    "mobile:build": "node scripts/build-mobile.js",
    "mobile:sync": "node scripts/build-mobile.js && cap sync android",
    "android": "npm run mobile:sync && cap open android"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "resedit": "^2.0.3",
    "socket.io-client": "^4.8.1"
  },
  "build": {
    "appId": "uk.co.lanternvtt.app",
    "productName": "Lantern VTT",
    "copyright": "Lantern VTT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "library.js",
      "campaign.js",
      "tunnel.js",
      "soundboard.js",
      "scenario.js",
      "props.js",
      "shared/**",
      "public/**",
      "!public/vendor/**",
      "electron/**",
      "package.json",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/**/*.d.mts",
      "!node_modules/pdfjs-dist/build/pdf.mjs",
      "!node_modules/pdfjs-dist/build/pdf.worker.mjs",
      "!node_modules/pdfjs-dist/build/pdf.sandbox*",
      "!node_modules/pdfjs-dist/legacy/build/pdf.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.sandbox*"
    ],
    "afterPack": "./build/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lantern VTT",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Lantern-VTT-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.role-playing-games",
      "identity": null,
      "artifactName": "Lantern-VTT-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Lantern uses your camera for video calls with your table.",
        "NSMicrophoneUsageDescription": "Lantern uses your microphone for voice and video calls with your table.",
        "NSBluetoothAlwaysUsageDescription": "Lantern connects to your GoDice smart dice over Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "Lantern connects to your GoDice smart dice over Bluetooth."
      }
    },
    "dmg": {
      "title": "Lantern VTT ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "Lantern-VTT-${version}-linux-${arch}.${ext}"
    }
  }
}
