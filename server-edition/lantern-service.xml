<!-- Lantern Server as a Windows service (WinSW). Install.cmd sets it up; you don't need to edit this. -->
<service>
  <id>LanternServer</id>
  <name>Lantern Server</name>
  <description>Lantern VTT, always on: players log in from a browser.</description>
  <executable>%BASE%\node\node.exe</executable>
  <arguments>"%BASE%\start.mjs"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <!-- after an update (or if it ever stops) it starts again by itself -->
  <onfailure action="restart" delay="3 sec"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
